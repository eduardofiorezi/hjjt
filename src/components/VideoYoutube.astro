---
import Icone from './Icone.astro';

interface Props {
  id: string;
  titulo: string;
  ano?: number;
}

const { id, titulo, ano } = Astro.props;
---

<figure class="video">
  <a class="video__capa" href={`https://www.youtube.com/watch?v=${id}`} data-video={id} data-titulo={titulo}>
    <img src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`} alt="" loading="lazy" width="480" height="360" />
    <span class="video__play"><Icone nome="play" /><span class="sr-only">Assistir {titulo}</span></span>
  </a>
  <figcaption>{titulo}{ano && <span class="video__ano"> ({ano})</span>}</figcaption>
</figure>

<script>
  // Troca a miniatura pelo player só quando a pessoa pede.
  document.addEventListener('click', (evento) => {
    const capa = (evento.target as Element).closest<HTMLAnchorElement>('a[data-video]');
    if (!capa || evento.metaKey || evento.ctrlKey) return;
    evento.preventDefault();
    const iframe = document.createElement('iframe');
    iframe.src = `https://www.youtube-nocookie.com/embed/${capa.dataset.video}?autoplay=1`;
    iframe.title = capa.dataset.titulo ?? 'Vídeo';
    iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
    iframe.allowFullscreen = true;
    capa.replaceWith(iframe);
  });
</script>

<style>
  .video {
    margin: 0;
  }

  .video__capa,
  .video :global(iframe) {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 0;
    background: var(--preto);
    overflow: hidden;
  }

  .video__capa img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .video__play {
    position: absolute;
    inset: 50% auto auto 50%;
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    translate: -50% -50%;
    border-radius: 50%;
    background: var(--vermelho);
    color: var(--branco);
  }

  .video__play :global(svg) {
    width: 1.4rem;
    margin-left: 0.2rem;
  }

  .video__capa:hover .video__play {
    background: var(--vermelho-texto);
  }

  figcaption {
    margin-top: 0.5rem;
    font-size: var(--t-14);
    font-weight: 600;
  }

  .video__ano {
    color: var(--grafite);
    font-weight: 400;
  }
</style>
