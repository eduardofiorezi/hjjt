---
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';

interface Props {
  fotos: ImageMetadata[];
  titulo: string;
}

const { fotos, titulo } = Astro.props;
const grandes = await Promise.all(fotos.map((foto) => getImage({ src: foto, width: Math.min(foto.width, 1600), format: 'webp' })));
---

<ul class="galeria" data-galeria>
  {
    fotos.map((foto, i) => (
      <li>
        <a href={grandes[i].src} data-foto>
          <Image src={foto} alt={`${titulo}, foto ${i + 1}`} widths={[240, 480]} sizes="(max-width: 40rem) 50vw, 16rem" />
        </a>
      </li>
    ))
  }
</ul>

<script>
  import '../scripts/lightbox';
</script>

<style>
  .galeria {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(11rem, 45%), 1fr));
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .galeria a {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--tatame);
  }

  .galeria img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .galeria a:hover img {
    opacity: 0.85;
  }

</style>
