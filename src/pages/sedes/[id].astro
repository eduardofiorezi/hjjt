---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import AcoesSede from '../../components/AcoesSede.astro';
import {
  DIAS,
  aulasDoDia,
  distanciaKm,
  getSedes,
  hora,
  jsonLdSede,
  local,
  maisProximas,
  paraCliente,
  type Sede,
} from '../../lib/sedes';

export const getStaticPaths = (async () => {
  const sedes = await getSedes();
  return sedes.map((sede) => ({ params: { id: sede.id }, props: { sede, todas: sedes } }));
}) satisfies GetStaticPaths;

interface Props {
  sede: Sede;
  todas: Sede[];
}

const { sede, todas } = Astro.props;
const { data } = sede;
const url = new URL(Astro.url.pathname, Astro.site).href;
const dias = DIAS.filter((d) => d.id !== 'dom' || aulasDoDia(sede, 'dom').length);
const vizinhas = maisProximas(sede, todas);
const descricao = `Jiu-jitsu na ${data.nome}, ${local(sede)}. Horários de treino, responsável e contato da sede da HJJT.`;

const migalhas = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Sedes', item: 'https://equipehjjt.com.br/sedes/' },
    { '@type': 'ListItem', position: 2, name: data.nome, item: url },
  ],
};
---

<Base titulo={`${data.nome}, ${local(sede)}`} descricao={descricao} jsonLd={[jsonLdSede(sede, url), migalhas]}>
  <article class="recuo pagina-sede">
    <nav class="migalhas" aria-label="Você está em">
      <a href="/sedes/">Todas as sedes</a>
    </nav>

    <header class="cabeca">
      <h1 class="titulo cabeca__nome">{data.nome}</h1>
      <p class="cabeca__local">{data.endereco ? `${data.endereco}, ${local(sede)}` : local(sede)}</p>
      {
        data.responsaveis.length > 0 && (
          <p class="cabeca__responsavel">
            {data.responsaveis.length > 1 ? 'Responsáveis' : 'Responsável'}:{' '}
            {new Intl.ListFormat('pt-BR').format(data.responsaveis)}
          </p>
        )
      }
      <p class="cabeca__proximo" data-proximo data-sede={JSON.stringify(paraCliente(sede))}></p>
      <AcoesSede sede={sede} completo />
    </header>

    <div class="corpo">
      <section aria-labelledby="titulo-horarios">
        <h2 class="secao" id="titulo-horarios">Horários</h2>
        {
          data.horarios.length ? (
            <dl class="grade">
              {dias.map((d) => {
                const aulas = aulasDoDia(sede, d.id);
                return (
                  <div class="grade__dia" data-dia={d.id}>
                    <dt>{d.longo}</dt>
                    <dd>
                      {aulas.length ? (
                        <ul>
                          {aulas.map((a) => (
                            <li>
                              <strong>
                                {hora(a.inicio)}
                                {a.fim && `–${hora(a.fim)}`}
                              </strong>
                              {a.turma && <span class="grade__turma">{a.turma}</span>}
                              {a.professor && <span class="grade__professor">com {a.professor}</span>}
                            </li>
                          ))}
                        </ul>
                      ) : (
                        <span class="grade__vazio">Sem treino</span>
                      )}
                    </dd>
                  </div>
                );
              })}
            </dl>
          ) : (
            <p class="sem-horario">
              Os horários desta sede ainda não estão no site. Fale com {data.responsaveis.length ? data.responsaveis[0] : 'a sede'} pelos
              contatos acima.
            </p>
          )
        }
        {
          data.observacoes.length > 0 && (
            <ul class="observacoes">
              {data.observacoes.map((o) => (
                <li>{o}</li>
              ))}
            </ul>
          )
        }
      </section>

      <section aria-label="Localização">
        <div class="mapa-sede" data-mapa data-sedes={JSON.stringify([sede, ...vizinhas].map(paraCliente))} data-destaque={sede.id}></div>
      </section>
    </div>

    <section class="vizinhas" aria-labelledby="titulo-vizinhas">
      <h2 class="secao" id="titulo-vizinhas">Sedes mais perto desta</h2>
      <ul>
        {
          vizinhas.map((v) => (
            <li>
              <a href={`/sedes/${v.id}/`} class="titulo">
                {v.data.nome}
              </a>
              <span>
                {local(v)}, a {Math.round(distanciaKm(data.coordenadas, v.data.coordenadas))} km
              </span>
            </li>
          ))
        }
      </ul>
    </section>
  </article>
</Base>

<script>
  import { criarMapa } from '../../scripts/mapa';
  import { diaDeHoje, proximoTreino } from '../../lib/proximo';
  import type { SedeCliente } from '../../lib/sedes';

  const proximo = document.querySelector<HTMLElement>('[data-proximo]')!;
  const sede: SedeCliente = JSON.parse(proximo.dataset.sede!);
  const texto = proximoTreino(sede);
  if (texto) proximo.textContent = `Próximo treino: ${texto}`;

  document.querySelector(`.grade__dia[data-dia="${diaDeHoje()}"]`)?.classList.add('grade__dia--hoje');

  const el = document.querySelector<HTMLElement>('[data-mapa]')!;
  const mapa = criarMapa(el, JSON.parse(el.dataset.sedes!), { destaque: el.dataset.destaque, zoom: 15 });
  mapa.enquadrar(new Set([sede.id]));
</script>

<style>
  .pagina-sede {
    padding-top: 1.5rem;
  }

  .migalhas a {
    font-size: var(--t-14);
    font-weight: 600;
  }

  .migalhas a::before {
    content: '‹ ';
  }

  .cabeca {
    padding-block: clamp(1.5rem, 5vw, 3rem) 2rem;
    border-bottom: 1px solid var(--linha);
  }

  .cabeca__nome {
    max-width: 16ch;
    font-size: clamp(3rem, 10vw, 6.5rem);
    line-height: 0.88;
  }

  .cabeca__local {
    margin-top: 1rem;
    font-size: var(--t-21);
  }

  .cabeca__responsavel {
    margin-top: 0.25rem;
    color: var(--grafite);
  }

  .cabeca__proximo {
    margin-block: 1rem 1.25rem;
    font-weight: 700;
    font-size: var(--t-18);
  }

  .cabeca__proximo:empty {
    display: none;
  }

  .corpo {
    display: grid;
    gap: 2.5rem;
    padding-top: 2.5rem;
  }

  @media (min-width: 56rem) {
    .corpo {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }

  .secao {
    margin-bottom: 1rem;
    font-size: var(--t-24);
    font-weight: 800;
  }

  .grade {
    margin: 0;
    border-top: 2px solid var(--preto);
  }

  .grade__dia {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: 0.75rem;
    padding: 0.85rem 0.5rem;
    border-bottom: 1px solid var(--linha);
  }

  .grade__dia--hoje {
    background: var(--tatame);
    box-shadow: inset 4px 0 0 var(--vermelho);
  }

  .grade__dia--hoje dt::after {
    content: ' (hoje)';
    color: var(--grafite);
    font-weight: 400;
  }

  .grade dt {
    font-weight: 700;
  }

  .grade dd {
    margin: 0;
  }

  .grade ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .grade__turma {
    margin-left: 0.35rem;
    padding: 0.05rem 0.4rem;
    border-radius: 0.2rem;
    background: var(--preto);
    color: var(--branco);
    font-size: var(--t-12);
    font-weight: 600;
    vertical-align: 0.1em;
  }

  .grade__professor {
    margin-left: 0.35rem;
    color: var(--grafite);
    font-size: var(--t-14);
  }

  .grade__vazio,
  .sem-horario {
    color: var(--grafite);
  }

  .observacoes {
    margin: 1rem 0 0;
    padding-left: 1.1rem;
    color: var(--grafite);
  }

  .mapa-sede {
    height: clamp(18rem, 50vh, 28rem);
    background: var(--tatame);
  }

  .vizinhas {
    margin-top: 3.5rem;
  }

  .vizinhas ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .vizinhas li {
    display: grid;
    gap: 0.25rem;
    padding-top: 0.75rem;
    border-top: 2px solid var(--preto);
  }

  .vizinhas a {
    font-size: var(--t-24);
    line-height: 1;
    text-decoration: none;
  }

  .vizinhas a:hover {
    color: var(--vermelho-texto);
  }

  .vizinhas span {
    color: var(--grafite);
    font-size: var(--t-14);
  }
</style>
